#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled data_dir listen port heap_mb proxy
	config_load deepseek-harness
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get data_dir main data_dir
	config_get listen main listen 127.0.0.1
	config_get port main port 28000
	config_get heap_mb main heap_mb 512
	config_get proxy main proxy
	/usr/lib/deepseek-harness/bin/node /usr/lib/deepseek-harness/prepare.mjs \
		"$data_dir" "$listen" "$port" "$heap_mb" "$proxy" || return 1
	chown deepseek-harness:deepseek-harness "$data_dir" "$data_dir/.dsh" \
		"$data_dir/tmp" "$data_dir/.cache" "$data_dir/documents" "$data_dir/web.patch.json" || return 1
	procd_open_instance main
	procd_set_param command /usr/lib/deepseek-harness/bin/serve \
		"$data_dir" "$port" "$heap_mb" "$proxy"
	config_list_foreach main trusted_host add_trusted_host
	procd_set_param user deepseek-harness
	procd_set_param group deepseek-harness
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 10 3
	procd_set_param term_timeout 20
	procd_set_param file /etc/config/deepseek-harness
	procd_close_instance
}

add_trusted_host() {
	procd_append_param command "$1"
}

service_triggers() {
	procd_add_reload_trigger deepseek-harness
}
